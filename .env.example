# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed and
# must never contain a real value.
#
# Every variable below is read by code in this repo (apps/*, packages/*, scripts/*,
# compose.yaml, crucible-contracts/foundry.toml). The set was enumerated from the
# call sites, not from memory — if you add a `process.env.X`, it belongs here.
#
# Default posture: the values shown are what the LOCAL demo stack needs (anvil on
# this machine, plain http, no TLS in front). Copying this file to a real host as-is
# is the failure mode marked BLOCKER below.
# ─────────────────────────────────────────────────────────────────────────────

# ── chain ────────────────────────────────────────────────────────────────────
# The only anvil cadence knob is its args: anvil reads its command line and no mode variable.
# Leave empty for the chain the deployment runs today — no `--block-time`, instant mine per tx,
# which `apps/api/src/security.ts` and `apps/web/src/lib/chainClock.ts` both assume. For
# 1-second blocks set: --block-time 1 --base-fee 1000000000 --chain-id 31337
ANVIL_MODE_ARGS=
# Deterministic addresses produced by the seed run. The seed container asserts the
# chain's observed addresses against these and refuses to start the API on a mismatch.
# Re-run the seed and update both, then rebuild the web image (they are baked into the
# browser bundle).
TRIALS_ADDRESS=
ALLOY_ADDRESS=
# The v2 arena (ADR-0011). Empty means it is not deployed on this chain: the keeper starts no
# arena crank loop and the API has no arena to serve. The seed writes it when it deploys one.
ARENA_ADDRESS=
# The TeamLedger (multi-agent attribution beside the escrow, not inside it). Empty means nothing is
# indexing one and GET /teams reports projected:false rather than an empty team list. It holds no
# trial reward and cannot move escrowed ETH: the escrow still has one claimant per trial, one bond,
# and one 5% fee. The seed script writes this when it deploys one.
TEAM_LEDGER_ADDRESS=

# Blocks to start indexing from. 0 = genesis.
FROM_BLOCK=0

# RPC for processes run directly on the host. Containers get RPC_URL from
# compose.yaml instead, which points at the anvil service by name.
RPC_URL=http://127.0.0.1:8545

# Used by foundry.toml's [rpc_endpoints] and by fork tests, which are opt-in.
# The values the deployment box runs with, recorded so a fresh clone is wired rather than
# guessing. They do not put CI on a third party's uptime: `ci.yml`'s fork job reads an Actions
# secret and skips with a loud warning when it is absent, and only `fork-nightly.yml` — whose
# sole purpose is to run the fork — falls back to the box's own `.env`, and refuses to be green
# when neither source answers. Empty here is still a valid state for a laptop clone.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Fork tests need an ARCHIVE endpoint at the pinned block. A public node that answers
# eth_chainId is not automatically enough: on 2026-10-26 ethereum-rpc.publicnode.com reported
# chain id 1 but pruned block 24,846,426 (`historical state ... is not available`), while
# eth.drpc.org served it and the four fork tests passed. So the pair below is in the order that
# measurement produced — archive-capable primary, chain-id-1-only fallback — and
# `npm run fork:test` tries the second only after the first is refused or fails. Measured
# 2026-10-27 with both legs exercised: a Sepolia primary is now refused by name (`eth_chainId is
# 0xaa36a7`) and the suite passes 4/4 through the fallback; a pruning mainnet node exits 1.
# Before that run the script called a wrong-chain endpoint a pass, because four `[SKIP]` lines
# and exit 0 looked identical to success and the fallback was never reached.
MAINNET_RPC_URL=https://eth.drpc.org
# Tried only after the primary fails, by the preflight and `npm run fork:test`.
MAINNET_RPC_FALLBACK_URL=https://ethereum-rpc.publicnode.com

# ── host-published ports (compose) ───────────────────────────────────────────
# 8545 is often already taken on a dev machine by another chain.
ANVIL_HOST_PORT=8555
API_HOST_PORT=8787
WEB_HOST_PORT=3000

# ── API ──────────────────────────────────────────────────────────────────────
PORT=8787

# ── identity ─────────────────────────────────────────────────────────────────
# Comma-separated addresses whose signed statement about a wallet counts as a human
# attestation. Empty means no issuer is configured; GET /identity/evidence reports that
# state rather than silently omitting the source.
IDENTITY_ATTESTORS=
# Human Passport eligibility, served by the isolated clean.sdk sidecar
# (integrations/clean-sdk). Empty means the source is unconfigured. The sidecar is a
# read-only check: it holds no key and never sends a transaction.
CLEAN_PASSPORT_URL=

# How often the API's index asks the node for new logs, in milliseconds. This is the
# biggest single term in how long a visitor waits to see a chain event appear. The code
# default is 2000, which is right for a public RPC; `compose.yaml` lowers it for the demo,
# where the node is a container on the same network. Below 100 is refused, because the
# poll loop would spin.
SCRIBE_POLL_MS=

# Where the keeper writes its hash-chained trace (one JSON line per action). Unset means
# no trace is written. Relative to the process working directory for host runs; compose
# sets it to /trace/keeper.jsonl on a named volume. Only sweeps that acted are recorded.
CRUCIBLE_TRACE_FILE=

# ── sign-in ──────────────────────────────────────────────────────────────────
#
# The origin this deployment signs for. It is the host the challenge message
# names, and it is CONFIGURATION rather than something the request can say: a
# message that says "evil.example wants you to sign in" is a message a third
# party can ask a victim to sign, and the wallet shows it verbatim. Required in
# production — with no origin the API answers 503 rather than signing anybody
# in.
AUTH_ORIGIN=http://localhost:3000

# The session signing secret. At least 16 characters. `openssl rand -base64 48`.
# With no secret the auth routes answer 503. They do NOT fall back to a
# built-in one, because a deployment that forgets the variable would then sign
# sessions with a key from the repository.
AUTH_SECRET=

# Opt in to the DEVELOPMENT secret (a published constant) by name. This is what
# the local demo needs and what a production deployment must never set.
AUTH_ALLOW_DEV_SECRET=

# The chain id the sign-in message names. EIP-4361 requires it, and without it
# a signature is replayable on another chain.
CHAIN_ID=31337

# ── keeper (the Warden service) ──────────────────────────────────────────────
# BLOCKER: PRIVATE_KEY signs real transactions. The keeper now enforces one rule and there is
# no silent default: it uses PRIVATE_KEY when set, and only falls back to Anvil's published dev
# key #0 when the RPC is a loopback host (127.0.0.1/localhost/::1) that itself answers
# eth_chainId with 31337. Every other combination — including a compose container talking to
# the `anvil` service over the docker network, which is NOT loopback — refuses to start rather
# than sign with a public key. So set KEEPER_PRIVATE_KEY for the compose stack (and for anything
# that is not `npm run demo` on a local anvil); leave it empty only to prove the keeper refuses.
PRIVATE_KEY=
KEEPER_PRIVATE_KEY=

# The Argus seat's voting key. One address, one seat: `commitVote` reverts unless the sender is in
# the committee the constructor granted (CrucibleTrials.sol:555), so this must be a granted address
# on THIS chain, and `apps/juror` checks `isArgus` at startup and refuses to loop rather than
# hammering a guaranteed revert on a shared node. There is no default: an Anvil dev key is public,
# so a fallback would be a voting key anyone in the world can derive, used by a service that
# reports itself healthy. On the demo chain the three seats are dev-mnemonic accounts #1/#2/#3 —
# worthless on purpose, and the honest statement of what a judge is looking at.
JUROR_SEAT_PRIVATE_KEY=

# How often the seat looks for disputes, and how long it waits before re-running a suite it could
# not decide last time. `REVERIFY_MS` is a cost control: an open dispute with no published artifact
# would otherwise be re-executed on every pass.
JUROR_PATROL_MS=30000
JUROR_REVERIFY_MS=900000

# Sweep interval (ms) and the alloy leaderboard refresh interval (ms). Sweeps are
# idempotent by construction, so a low number costs RPC reads, not correctness.
SWEEP_MS=15000
ALLOY_TTL_MS=30000

# Comma-separated kill-switch flags the keeper obeys with no deploy. Setting this to
# `keeper.sweep` halts all acting on the next flag poll. Empty = nothing killed.
KILL_SWITCHES=

# The wei floor at which the keeper calls its own wallet low on `/health`. Unset means the
# balance is published and no alarm is raised — a floor invented in code would be an opinion
# about somebody else's wallet, and a demo wallet and a production signer need different ones.
# Gas spent and the balance itself are reported whether or not this is set.
KEEPER_MIN_BALANCE_WEI=

# Optional Warden notification webhook. Empty disables notifications.
WARDEN_WEBHOOK_URL=

# ── LLM providers ────────────────────────────────────────────────────────────
# The live agent (`npm run agent:live`) and any model-backed service read these.
# NVIDIA NIM and Groq are both OpenAI-compatible; Anthropic is not, and needs a paid
# key. Set at least one. Leave the others blank rather than putting a placeholder in:
# a bogus key fails at the first real call, which looks like a broken agent.
#
# Model availability is account-specific and changes. Verify with a real call before
# relying on a model id; `forge-runner/src/providers.ts` records the ones measured on
# this repo's own fixture.
NVIDIA_API_KEY=
NIM_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ── Frenchy (optional voice host) ─────────────────────────────────────────────
# The API holds this key; the browser never does. Leave either the key or the voice
# id blank and the voice control hides itself. `VOICE_DISABLED=1` is the kill switch
# for a deployment that has the credentials but wants silence.
#
# ELEVENLABS_VOICE_ID is the voice's id from the ElevenLabs dashboard, not its name.
# The default model is the low-latency Flash model the demo's <1s budget assumes.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v4
# Reserved for a conversational ElevenLabs Agents integration. The current
# one-way TTS host uses ELEVENLABS_VOICE_ID, not this id.
ELEVENLABS_AGENT_ID=
# Override only for a compatible proxy or a test server.
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# VOICE_DISABLED=0

# ── Coinbase CDP CLI / Sandbox ────────────────────────────────────────────────
# Two different CLIs, two different keys:
#   `coinbase` (Advanced Trade + x402) uses `coinbase env live --key-file ...`
#   `cdp`     (CDP Sandbox/custodial)  uses `cdp env sandbox --key-file ...`
# The key JSON is a secret and must live outside git. Set the path here and run
# `npm run cdp:sandbox`; the wrapper configures the sandbox profile and lists its
# accounts. Leave the path empty until you have downloaded the Sandbox key.
# The demo stays on sandbox. Live is refused unless explicitly enabled; both
# key paths can coexist in this one file, selected by CDP_ENV.
CDP_ENV=sandbox
CDP_ENABLE_LIVE=0
# Use either the key JSON paths or the inline ID/secret pair. The wrapper picks
# the active mode's pair; the live pair is ignored while live is disabled.
CDP_SANDBOX_API_KEY_FILE=
CDP_SANDBOX_API_KEY_ID=
CDP_SANDBOX_API_KEY_SECRET=
CDP_LIVE_API_KEY_FILE=
CDP_LIVE_API_KEY_ID=
CDP_LIVE_API_KEY_SECRET=
# Optional legacy fallback if you keep one key path for the active env.
CDP_API_KEY_FILE=
# The cdp CLI cannot use the OS keychain from every harness. Set this to 1 only
# where that is true; it stores the CLI secret in its own config file.
CDP_ALLOW_PLAINTEXT_SECRETS=0
CDP_SANDBOX_BASE_URL=https://sandbox.cdp.coinbase.com
CDP_LIVE_BASE_URL=https://api.cdp.coinbase.com/platform/v2
# The account `npm run cdp:transfer` debits. Leave empty and the script picks the
# first crypto account it can see; name it here when there is more than one.
CDP_ACCOUNT_ID=
# Retries replay a transfer instead of doubling it, because the Idempotency-Key
# header is derived from the run id. Copy the run id a failed attempt printed and
# re-run with it set; leave empty to mint a fresh one.
CDP_RUN_ID=
# CDP_ENV governs the scripts above. The site's own sandbox/live chip in the header
# is driven by NEXT_PUBLIC_CHAIN further down, because that is what the browser can
# actually verify — a badge fed by a server-side flag would be decoration.

# ── Funder service ──────────────────────────────────────────────────────────
# A separate process from `apps/api` that holds the CDP credential (ADR-0015 §1).
# The API asks it for allocations over an internal socket; it never holds the key.
# The funder dispenses USDC on Base Sepolia (constant, not a setting — ADR-0015 §2).
# Not reachable from the browser: bound to loopback on the port below.
FUNDER_URL=http://127.0.0.1:8788
FUNDER_HOST=127.0.0.1
FUNDER_PORT=8788

# Where the funder asks for a wallet's Sybil-risk score before dispensing (ADR-0015).
# The score is read-only and public: it names on-chain evidence, not a secret.
#   * both processes on one host  -> loopback, below
#   * VPS                         -> the edge URL, because `compose.vps.yaml` resets the
#                                    api's published ports on purpose:
#                                    IDENTITY_API_URL=https://crucible.svalley.tech/api
# An unreachable identity service does not stop the faucet: the allocation falls back to the
# base drip and the response says `risk.available: false` rather than implying a clean score.
IDENTITY_API_URL=http://127.0.0.1:8787

# ── web bundle ───────────────────────────────────────────────────────────────
# Baked at BUILD time, not read at runtime — changing a value means rebuilding the
# web image; editing it in a running container does nothing.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
# What the browser uses to send wallet transactions. On the deployed site this is the
# reverse-proxied path, not a port on the host.
NEXT_PUBLIC_ANVIL_RPC=http://127.0.0.1:8555
# viem chain name: `foundry` for the local demo chain, `sepolia` for a testnet.
NEXT_PUBLIC_CHAIN=foundry
NEXT_PUBLIC_TRIALS_ADDRESS=
NEXT_PUBLIC_ALLOY_ADDRESS=
# Optional: VerificationReceipt ERC-721 (gates 415-418). Empty = minting feature disabled.
NEXT_PUBLIC_VERIFICATION_RECEIPT_ADDRESS=
# Canonical origin for metadataBase, canonical URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Sponsor fiat -> ETH on-ramp fallback. The primary path is POST /onramp/session, which mints
# one single-use Coinbase URL per click; this landing URL is used only when that endpoint is
# not configured. Empty hides the fallback. The provider sends ETH to the sponsor's own wallet;
# CRUCIBLE never holds it, and the escrow still settles in native ETH (ADR-0001). Mainnet only.
# What none of this touches, stated where an operator reads configuration:
#   no custody of anyone's keys, no ERC-20 or stablecoin on the escrow path, no token bridge.
#   The escrow settles in native ETH and FEE_BPS = 500 (5%) — measured on the deployed contract,
#   not copied from a document. A change to that is a new ADR and a contract review, not an env edit.
NEXT_PUBLIC_ONRAMP_URL=https://pay.coinbase.com/landing
# Unused in the current build — the wallet path uses the injected provider directly and
# login is OTP-only, so no WalletConnect project is registered.
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── API transport policy ─────────────────────────────────────────────────────
# Threat model, what each control is actually worth, and an nginx snippet are in
# docs/security-headers.md. Malformed numbers fall back to the default rather than
# removing the limit.

# Browser origins allowed to read the API (comma- or space-separated). `*` selects the
# public-anonymous policy (reads allowed, credentials never) rather than a wider list.
ALLOWED_ORIGINS=
# Send Access-Control-Allow-Credentials. Only honoured with an exact origin match.
ALLOW_CREDENTIALS=false

# Ceiling on an announced Content-Length, and the ms at which a handler that never
# answered gets a 504. `/stream` is exempt from the timeout, not from the ceiling.
MAX_BODY_BYTES=1048576
REQUEST_TIMEOUT_MS=15000

# The agent surface has its own bucket. `/mcp` is exempt from the global read limiter and
# charged here instead, so an agent loop cannot spend the browser's allowance. Requests per
# minute, plus a burst above the sustained rate.
MCP_RATE_LIMIT=30
MCP_RATE_BURST=10

# 403 any request that did not arrive over TLS, and the max-age of the
# Strict-Transport-Security header. Enable ENFORCE_HTTPS only when something in front
# has genuinely terminated TLS — HSTS on a plaintext host pins browsers to a breakage.
ENFORCE_HTTPS=false
HSTS_MAX_AGE=31536000

# How many blocks behind the chain head still counts as ready for GET /ready.
READY_MAX_LAG=5

# Forwarded headers name the client AND the forwarded protocol is believed. Enable
# only behind a proxy that SETS `X-Forwarded-For` — Caddy and nginx both do, and
# Caddy replaces the header with the peer it saw rather than appending to whatever
# the caller sent.
#
# The rate limiter's key is the RIGHT-MOST `X-Forwarded-For` entry, which is the
# address the proxy actually saw. Never the left-most: that is the one a caller
# writes, so reading it lets a client mint a fresh bucket per request. `X-Real-IP`
# is not read at all — Caddy does not set it by default and passes a caller's copy
# straight through, so it is a header the caller chooses.
#
# With this off, every visitor behind the proxy shares ONE bucket, because the only
# address the API can see is the proxy's. A deployment behind Caddy wants this ON.
TRUST_PROXY=0
