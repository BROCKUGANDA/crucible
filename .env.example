PRIVATE_KEY=
SEPOLIA_RPC_URL=

# required by apps/api
RPC_URL=http://127.0.0.1:8545
TRIALS_ADDRESS=
ALLOY_ADDRESS=
FROM_BLOCK=0
PORT=8787

# required by apps/keeper (the Warden service); PRIVATE_KEY is the signing key for
# permissionless finalize/reclaim — demo default is Anvil's published dev key #0
KEEPER_PRIVATE_KEY=

# optional: Warden notifications
WARDEN_WEBHOOK_URL=

# ── apps/api transport policy ─────────────────────────────────────────────
# Every default below keeps the local demo working over plain http. The threat model,
# what each control is actually worth, and an nginx snippet are in
# docs/security-headers.md — read it before setting ENFORCE_HTTPS on a real host.
# Malformed numbers are ignored rather than honoured, so a typo falls back to the
# default instead of removing a limit.

# Browser origins allowed to read the API. Comma- or space-separated. Setting `*`
# selects the public-anonymous policy (reads allowed, credentials never) rather than a
# wider allowlist. Leaving it blank uses the four demo origins.
ALLOWED_ORIGINS=
ALLOW_CREDENTIALS=

# Ceiling on an announced Content-Length, and the point at which a handler that never
# answered gets a 504. `/stream` is exempt from the timeout, not from the ceiling.
MAX_BODY_BYTES=
REQUEST_TIMEOUT_MS=

# 403 any request that did not arrive over TLS, and the max-age of the
# Strict-Transport-Security header. HSTS is only ever sent for a request that was TLS.
# Enable ENFORCE_HTTPS only when something in front has genuinely terminated TLS.
ENFORCE_HTTPS=
HSTS_MAX_AGE=

# How many blocks behind the chain head still counts as ready for GET /ready.
READY_MAX_LAG=

# Existing variable, now doing double duty: forwarded headers name the client AND the
# forwarded protocol is believed. Enable only behind a proxy that overwrites both —
# believing X-Forwarded-Proto from a caller is how a plaintext request mints an HSTS pin.
TRUST_PROXY=
