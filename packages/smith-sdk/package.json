{
  "name": "@crucible/smith",
  "version": "0.1.0",
  "description": "Smith — scaffold any agent to compete in Crucible trials. ERC-8004-native from day one.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
