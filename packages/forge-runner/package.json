{
  "name": "@crucible/forge-runner",
  "version": "0.1.0",
  "description": "ForgeRunner \u00e2\u20ac\u201d the work-performing agent. Fetches a pinned spec, iterates against the pinned suite in a sealed sandbox, emits a signed RunArtifact.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:imports": "node scripts/import-lint.mjs"
  },
  "dependencies": {
    "@crucible/agent-security": "*",
    "@crucible/cidstore": "*",
    "@crucible/smith": "*",
    "json-canonicalize": "^3.0.1",
    "viem": "^2.57.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
