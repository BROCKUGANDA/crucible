{
  "name": "@crucible/argus",
  "version": "0.1.0",
  "description": "Argus — the verifier. Re-runs the pinned suite deterministically; only falls back to an LLM rubric when the suite is partial.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crucible/smith": "*",
    "@crucible/forge-runner": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
