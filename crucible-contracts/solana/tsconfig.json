{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitReturns": true,
    "types": ["mocha", "chai", "node"]
  },
  "include": ["tests/**/*.ts", "migrations/**/*.ts"],
  "exclude": ["node_modules"]
}
