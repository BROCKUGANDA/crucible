# deps
node_modules/
.pnpm-store/

# build output
dist/
.next/
out/
*.tsbuildinfo

# foundry
crucible-contracts/out/
crucible-contracts/cache/
crucible-contracts/broadcast/

# a locally written trace spine
trace/

# gate artefacts, written by CI and by `npm run coverage:gate`
coverage-summary.txt
audit.json
gas-report.txt
lcov.info
cov-*.txt

# Local agent configuration; AGENTS.md is the canonical instructions.
.claude/
CLAUDE.md

# env
.env
.env.*

# Coinbase CDP API key JSON files are secrets; keep them out of history.
cdp_api_key*.json
*.cdp-key.json
.cdp/
!.env.example

# Local scratch: ad-hoc probe logs, mutation-proof transcripts and throwaway
# analysis scripts written during a session. Never source - and several of the
# logs carry content digests that gitleaks reads as key-shaped strings.
.scratch/

# Throwaway helpers a session writes at the repo root while chasing a CI log.
# They hardcode one machine's paths and read nothing the repo needs.
/fetchlog.js
/findsnap.js
/findsnap2.js
/scan.js
/pkg.json

# A session's VPS runner-setup scripts, written at the repo root while it wires
# self-hosted runners. Two reasons they must never be committed: they hardcode
# one machine's paths and an SSH key, and they carry a **GitHub Actions runner
# registration token in plaintext**. The secrets job scans `--all`, so one
# token-shaped string in one of them reddens every branch - which is what
# commit 75c4643 did with a localStorage key, and why the gate exists. The
# scripts are another session's live work, so they are ignored rather than
# deleted; the token in them should be revoked by whoever owns it.
/setup*.js
/svc*.js
/svc-vps*.service
/tok.js

# The business PDFs are local renders of the markdown beside them, with no
# committed generator: three of the four disagree with their sources because
# the test counts moved under them. Left out rather than committed stale.
docs/business/*.pdf

# editors / os
.DS_Store
Thumbs.db
build/
coverage/
*.lcov
*.log
npm-debug.log*
.idea/
.vscode/
*.swp
apps/web/.env.local

# graphflow
.graphflow-cache/
graphflow-out/

# OpenChamber session screenshots
.openchamber/

# Content store for pinned demo trial content (scripts/seed-content.mjs). Bytes addressed
# by a chain digest, regenerable from the fixtures; not a build artifact to commit.
.crucible-content/

# forge writes this on any build in the contracts directory; it pins resolved lib commits,
# which are already pinned by lib/.gitmodules — so it is a build artifact here, not a lockfile.
crucible-contracts/foundry.lock

# Mimosa security-scan runtime state: hook baselines, source snapshots, finding ledgers.
# Nothing under .mimosa/ is source; 23 hook-state files were once staged by accident.
# A project security policy (.mimosa/security-policy.json), if ever declared, should be
# un-ignored explicitly so it ships deliberately.
.mimosa/

# datasets is a tracked workspace — un-ignored so CI can typecheck it
!packages/datasets/

