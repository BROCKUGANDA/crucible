# Mainnet deployment template (NO SECRETS). Copy relevant values into your
# deployment environment / secret manager. Do NOT commit real keys or secrets.
#
# Server-side RPC (secret if it contains an API key). Use for API/keeper/juror
# and mainnet-preflight. Rotate any key that was ever pasted into chat/logs.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
ALCHEMY_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
CHAIN_ID=1

# Browser RPC must be KEYLESS/PUBLIC or proxied — never put an API key in
# NEXT_PUBLIC_* (it ships to every user's browser).
NEXT_PUBLIC_CHAIN=mainnet
NEXT_PUBLIC_MAINNET_RPC=https://ethereum-rpc.publicnode.com

# Fill ONLY after real mainnet deployments exist and treasury.json is verified.
# The API fail-closes at boot if TRIALS_ADDRESS has no bytecode on CHAIN_ID.
TRIALS_ADDRESS=
ALLOY_ADDRESS=
ARENA_ADDRESS=
TEAM_LEDGER_ADDRESS=
NEXT_PUBLIC_MAINNET_TRIALS_ADDRESS=
NEXT_PUBLIC_MAINNET_ALLOY_ADDRESS=

# Treasury/Owner Safes (must match docs/mainnet/treasury.json; distinct 2-of-3).
TREASURY_ADDRESS=
OWNER_SAFE_ADDRESS=

# Production auth/origin (required for SIWE in non-dev; never use dev secret).
AUTH_ORIGIN=https://<your-production-origin>
AUTH_SECRET=<strong-random-secret>
AUTH_ALLOW_DEV_SECRET=0
ENFORCE_HTTPS=1
TRUST_PROXY=1

# Keep the local Anvil demo defaults in compose; do not point the live demo VPS
# at mainnet until contracts/Safes are deployed and preflight passes.

# ── Mainnet switch (one-switch prep; fill ONLY after gates pass) ─────────────
# NEXT_PUBLIC_CHAIN=mainnet drives the browser default; the wallet's own chain
# still wins at runtime (EVM + Solana switching both supported).
# DEPLOYER_PRIVATE_KEY: deployer key (never commit). PRIVATE_KEY fallback supported.
# STORAGE_BACKEND=postgres + DATABASE_URL required in production (fail-closed).
# STAMP_MODE=production requires signed manifest + counsel + MetaDAO approval.
# Solana production: NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta + verified mint.
# DEPLOYER_PRIVATE_KEY=
# PRIVATE_KEY=
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/crucible
# STAMP_MODE=disabled
# NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# NEXT_PUBLIC_SOLANA_DEVNET_RPC=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
# NEXT_PUBLIC_ENGRAM_BASE_URI=ipfs://<METADATA_CID>/{id}.json
