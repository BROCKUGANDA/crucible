{
  "name": "@crucible/juror",
  "version": "0.1.0",
  "private": true,
  "description": "The Argus seat as a service: re-runs the pinned suite against a Challenged trial and casts this seat's commit and reveal.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crucible/argus": "*",
    "@crucible/cidstore": "*",
    "@crucible/forge-runner": "*",
    "@crucible/indexer": "*",
    "@crucible/smith": "*",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
