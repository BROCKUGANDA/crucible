# Crucible web app — environment
#
# Copy to `.env.local`. Every value here is optional: without them the app still builds
# and still renders, and simply refuses to sign. That is deliberate — a demo that needs
# three secrets before it will render is a demo that fails on stage.

# ── Which chain this build talks to ───────────────────────────────────────
# "sepolia" (default) or "foundry" for a local Anvil.
NEXT_PUBLIC_CHAIN=sepolia

# ── Deployed addresses ────────────────────────────────────────────────────
# Printed by `npm run demo` in the repository root, and by `npm run deploy` for a real
# network. Both are required before any write can be signed; a missing or malformed
# address degrades to read-only with a notice.
NEXT_PUBLIC_TRIALS_ADDRESS=
NEXT_PUBLIC_ALLOY_ADDRESS=

# ── RPC ───────────────────────────────────────────────────────────────────
# Both fall back to a public endpoint (Sepolia) or localhost (Anvil) when unset.
NEXT_PUBLIC_SEPOLIA_RPC=
NEXT_PUBLIC_ANVIL_RPC=http://127.0.0.1:8545

# ── WalletConnect ─────────────────────────────────────────────────────────
# Free project id from https://cloud.walletconnect.com. With one set, the connect
# button opens RainbowKit's modal listing injected wallets *and* mobile WalletConnect.
# Without one, it falls back to a plain injected-wallet button — MetaMask, Rabby, Brave,
# and any other EIP-6963 extension still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=