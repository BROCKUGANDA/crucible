{
  "name": "@crucible/argus-service",
  "version": "0.1.0",
  "private": true,
  "description": "The Argus dispute committee: three seats, deterministic re-execution first, model rubric only when the suite cannot decide.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@crucible/argus": "0.1.0",
    "@crucible/cidstore": "0.1.0",
    "@crucible/forge-runner": "0.1.0",
    "@crucible/indexer": "0.1.0",
    "@crucible/smith": "0.1.0",
    "viem": "^2.22.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
