{
  "name": "crucible",
  "version": "0.1.0",
  "private": true,
  "description": "Crucible â€” a proving ground where AI agents are forged into on-chain trust.",
  "license": "UNLICENSED",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "crucible-contracts",
    "grader"
  ],
  "scripts": {
    "build:libs": "npm run build --workspace @crucible/site-index && npm run build --workspace @crucible/smith && npm run build --workspace @crucible/cidstore && npm run build --workspace @crucible/crypto && npm run build --workspace @crucible/eval && npm run build --workspace @crucible/engrams && npm run build --workspace @crucible/agent-security && npm run build --workspace @crucible/forge-watch && npm run build --workspace @crucible/forge-runner && npm run build --workspace @crucible/frame && npm run build --workspace @crucible/indexer && npm run build --workspace @crucible/argus && npm run build --workspace @crucible/warden && npm run build --workspace @crucible/grader && npm run build --workspace @crucible/arena-events && npm run build --workspace @crucible/registry && npm run build --workspace @crucible/datasets",
    "prepare": "npm run build:libs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:edge": "node deploy/edge/run-tests.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "verify:all": "npm run typecheck && npm test && npm run test:edge",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "contracts:build": "npm run build --workspace crucible-contracts",
    "mcp:agent": "node --env-file-if-exists=.env apps/api/scripts/mcp-agent.mjs",
    "contracts:test": "npm run test --workspace crucible-contracts",
    "contracts:demo": "npm run demo --workspace crucible-contracts",
    "api:dev": "npm run dev --workspace @crucible/api",
    "web:dev": "npm run dev --workspace @crucible/web",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "test:e2e": "node --env-file-if-exists=.env scripts/demo.mjs --exit",
    "mainnet:preflight": "node --env-file-if-exists=.env scripts/mainnet-preflight.mjs",
    "site-index": "node --experimental-strip-types scripts/site-index.ts",
    "site-index:check": "node --experimental-strip-types scripts/site-index.ts --check",
    "deploy:network": "node --env-file-if-exists=.env scripts/deploy-network.mjs",
    "fork:test": "node --env-file-if-exists=.env scripts/run-fork-tests.mjs",
    "agent:live": "node --env-file-if-exists=.env scripts/live-agent.mjs",
    "cdp:sandbox": "node --env-file-if-exists=.env scripts/cdp-sandbox.mjs",
    "cdp:transfer": "node --env-file-if-exists=.env scripts/cdp-transfer.mjs",
    "funder:dev": "npm run dev --workspace @crucible/funder",
    "verify:roundtrip": "node --env-file-if-exists=.env scripts/verify-roundtrip.mjs",
    "seed:content": "node --env-file-if-exists=.env scripts/seed-content.mjs --write",
    "seed:check": "node --env-file-if-exists=.env scripts/seed-content.mjs --check",
    "arena:grade": "node --env-file-if-exists=.env scripts/grade-arena.mjs",
    "export:identity": "node scripts/export-identity-features.mjs",
    "fit:identity": "node scripts/fit-identity.mjs",
    "identity:export": "node scripts/export-identity-features.mjs",
    "identity:label": "node scripts/label-identity-corpus.mjs",
    "identity:fixtures": "node scripts/generate-sybil-label-fixtures.mjs",
    "identity:fixtures:check": "node scripts/generate-sybil-label-fixtures.mjs --check",
    "identity:fit": "node scripts/fit-identity.mjs",
    "identity:fit:selftest": "node scripts/fit-identity.mjs --self-test",
    "clean-sdk:install": "npm --prefix integrations/clean-sdk install --ignore-scripts --no-audit --no-fund",
    "clean-sdk:test": "npm --prefix integrations/clean-sdk test"
  },
  "engines": {
    "node": ">=20 <27",
    "npm": ">=10"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "ws": "8.21.0"
  },
  "overrides": {
    "brace-expansion@<2": "1.1.20",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@3": "3.0.6",
    "brace-expansion@>=4": "5.0.9",
    "ip-address": "10.3.1",
    "picomatch@4": "4.0.4",
    "pacote": "21.5.1",
    "sigstore": "4.1.1",
    "decode-uri-component": "0.5.1",
    "follow-redirects@<2": "1.16.2",
    "ws@8": "8.21.0",
    "ws@<8": "7.5.13"
  }
}
