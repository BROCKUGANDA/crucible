{
  "name": "crucible",
  "version": "0.1.0",
  "private": true,
  "description": "Crucible \u00e2\u20ac\u201d a proving ground where AI agents are forged into on-chain trust.",
  "license": "MIT",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "crucible-contracts"
  ],
  "scripts": {
    "build:libs": "npm run build --workspace @crucible/smith && npm run build --workspace @crucible/cidstore && npm run build --workspace @crucible/agent-security && npm run build --workspace @crucible/forge-runner && npm run build --workspace @crucible/indexer && npm run build --workspace @crucible/argus && npm run build --workspace @crucible/warden",
    "prepare": "npm run build:libs",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:all": "npm run typecheck && npm test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "contracts:build": "npm run build --workspace crucible-contracts",
    "contracts:test": "npm run test --workspace crucible-contracts",
    "contracts:demo": "npm run demo --workspace crucible-contracts",
    "api:dev": "npm run dev --workspace @crucible/api",
    "web:dev": "npm run dev --workspace @crucible/web",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "agent:live": "node --env-file-if-exists=.env scripts/live-agent.mjs",
    "cdp:sandbox": "node --env-file-if-exists=.env scripts/cdp-sandbox.mjs",
    "cdp:transfer": "node --env-file-if-exists=.env scripts/cdp-transfer.mjs",
    "verify:roundtrip": "node --env-file-if-exists=.env scripts/verify-roundtrip.mjs",
    "seed:content": "node --env-file-if-exists=.env scripts/seed-content.mjs --write",
    "seed:check": "node --env-file-if-exists=.env scripts/seed-content.mjs --check"
  },
  "engines": {
    "node": ">=20 <27",
    "npm": ">=10"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.7.3"
  }
}
